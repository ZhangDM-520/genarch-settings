# The unit list has one home: the intent, through `genarch units`. Restating it here would make
# a renamed unit need two more edits, and a reordered `[units]` a silent mismatch.
units() {
  /usr/bin/genarch units 2>/dev/null || true
}

post_install() {
  # Deploy the intent's mirrors and units, then enable what the package wires up. The units
  # themselves ship as intent (one home), so they only exist after an apply.
  /usr/bin/genarch apply || true
  systemctl daemon-reload
  udevadm control --reload || true
  enabled=$(units)
  if [ -n "$enabled" ]; then
    systemctl enable $enabled || true
  fi
}

post_upgrade() {
  post_install
}

pre_remove() {
  enabled=$(units)
  if [ -n "$enabled" ]; then
    systemctl disable $enabled 2>/dev/null || true
  fi
}
