post_install() {
  # Deploy the intent's mirrors and units, then enable what the package wires up. The units
  # themselves ship as intent (one home), so they only exist after an apply.
  /usr/bin/genarch apply || true
  systemctl daemon-reload
  udevadm control --reload || true
  systemctl enable genarch.service genarch-ceil.timer || true
}

post_upgrade() {
  post_install
}

pre_remove() {
  systemctl disable genarch.service genarch-ceil.timer 2>/dev/null || true
}
