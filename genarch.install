post_install() {
  # Deploy the intent's mirrors and units, then enable what the package wires up. The units
  # themselves ship as intent (one home), so they only exist after an apply.
  /usr/bin/genarch apply || true
  systemctl daemon-reload
  udevadm control --reload || true
  # The unit list has one home: ask the intent, do not restate it here.
  units=$(/usr/bin/genarch units 2>/dev/null) || units=""
  if [ -n "$units" ]; then
    systemctl enable $units || true
  fi
}

post_upgrade() {
  post_install
}

pre_remove() {
  units=$(/usr/bin/genarch units 2>/dev/null) || units=""
  if [ -n "$units" ]; then
    systemctl disable $units 2>/dev/null || true
  fi
}
